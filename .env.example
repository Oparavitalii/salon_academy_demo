# Copy to .env.local. Every value here is a placeholder — never commit real keys.
#
# Public demo (no accounts needed): `npm run demo` sets DEMO_MODE=1 and a demo AUTH_SECRET for you.
# With DEMO_MODE=1 and no DATABASE_URL the app uses an embedded Postgres (PGlite) with fictional
# data; without Stripe / Resend / Bunny keys it simulates checkout, writes e-mails to .dev_outbox/
# and shows lessons without video.
DEMO_MODE=1

# --- Auth.js -----------------------------------------------------------------------------------
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# --- Site URLs ---------------------------------------------------------------------------------
# Base for e-mail links and Stripe return URLs.
APP_URL=http://localhost:3000
# Public origin for SEO (canonical, hreflang, sitemap). Defaults to https://example.com.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (Postgres) -----------------------------------------------------------------------
# Leave empty in demo mode. Neon: pooled URL here, direct URL below (used by drizzle-kit and backups).
# Local Postgres: postgres://postgres:postgres@localhost:5432/studio and DATABASE_DRIVER=pg.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
DATABASE_DRIVER=

# --- First admin (npm run db:seed-admin) -------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=

# --- Stripe Checkout ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Comma-separated e-mails allowed to pay with a Stripe TEST key on production (/checkout/test).
TEST_CHECKOUT_ALLOWLIST=

# --- Resend (e-mail) ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Studio Demo <noreply@example.com>"

# --- Bunny Stream (signed lesson video URLs) ---------------------------------------------------
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_TOKEN_KEY=

# --- Login geolocation (optional) --------------------------------------------------------------
GEO_DB_PATH=
TRUST_CLOUDFLARE=
GEO_TRUST_ANY=

# --- Analytics / marketing, loaded only after cookie consent (optional) ------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Backups (scripts/Backup, reference workflows) ---------------------------------------------
BACKUP_ENCRYPTION_KEY=
RESTORE_TARGET_URL=
