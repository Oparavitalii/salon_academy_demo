{
  "name": "salon-academy-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "demo": "node scripts/demo.mjs dev",
    "demo:build": "node scripts/demo.mjs build",
    "demo:start": "node scripts/demo.mjs start",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/db_seed.ts",
    "db:seed-admin": "tsx --env-file-if-exists=.env.local scripts/db_seed_admin.ts",
    "db:sync-lessons": "tsx --env-file-if-exists=.env.local scripts/db_sync_lessons.ts",
    "db:sync-catalog": "tsx --env-file-if-exists=.env.local scripts/db_sync_catalog.ts",
    "db:purge-test-payments": "tsx --env-file-if-exists=.env.local scripts/db_purge_test_payments.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@auth/core": "^0.41.0",
    "@electric-sql/pglite": "^0.5.13",
    "@neondatabase/serverless": "^1.0.2",
    "@pdf-lib/fontkit": "1.1.1",
    "@types/three": "0.170.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "drizzle-orm": "0.45.3",
    "hls.js": "1.5.20",
    "next": "16.4.5",
    "next-auth": "^5.0.0-beta.30",
    "next-intl": "^4.14.9",
    "pdf-lib": "1.17.1",
    "pg": "^8.23.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "6.32.1",
    "stripe": "22.6.2",
    "three": "0.170.0",
    "zod": "4.6.5",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "playwright": "^1.64.1",
    "prettier": "^3.8.1",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
